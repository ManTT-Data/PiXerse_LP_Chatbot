# =============================================================================
# DATABASE CONFIGURATION (Aiven PostgreSQL) - REQUIRED
# =============================================================================
DATABASE_URL=postgres://avnadmin:AVNS_8dOpRsLGGzmJF6bjBwm@pix-verse-ip6ofme-c71c.j.aivencloud.com:12317/defaultdb?sslmode=require
DB_URL=postgres://avnadmin:AVNS_8dOpRsLGGzmJF6bjBwm@pix-verse-ip6ofme-c71c.j.aivencloud.com:12317/defaultdb?sslmode=require

# Example with actual Aiven format:
# DATABASE_URL=postgresql+asyncpg://avnadmin:AVNS_xxxxx@your-service-name.aivencloud.com:12317/defaultdb
# DB_URL=postgresql+asyncpg://avnadmin:AVNS_xxxxx@your-service-name.aivencloud.com:12317/defaultdb

# =============================================================================
# OPENAI CONFIGURATION - REQUIRED
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=10.0

# Get your API key from: https://platform.openai.com/api-keys
# Available models: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo

# =============================================================================
# APPLICATION CONFIGURATION - REQUIRED
# =============================================================================
ENVIRONMENT=local
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=1

# Environment options: local, development, staging, production
# DEBUG: true for development, false for production

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO

# Available levels: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# SECURITY CONFIGURATION - REQUIRED
# =============================================================================
SECRET_KEY=your-super-secure-secret-key-here

# Generate a secure secret key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Example: SECRET_KEY=abc123XYZ789-secure-random-string-here

# =============================================================================
# CORS CONFIGURATION - REQUIRED
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
BACKEND_CORS_ORIGINS_STR=http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1

# Add your frontend domains here, comma-separated
# Production example: https://yourapp.com,https://api.yourapp.com

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
MCP_SERVER_CONFIG_PATH=core/config/server_config.json

# Path to MCP server configuration file
# Default: core/config/server_config.json

# =============================================================================
# APPLICATION BEHAVIOR
# =============================================================================
RELOAD=true

# Auto-reload on code changes (development only)
# Set to false in production

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================
SENTRY_DSN=
SENTRY_SAMPLE_RATE=1.0

# Sentry error tracking (optional)
# Get DSN from: https://sentry.io/
# Sample rate: 0.0 to 1.0 (percentage of events to capture)

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file: cp env-example .env
#
# 2. Update DATABASE_URL and DB_URL with your Aiven PostgreSQL credentials
#    - Get from your Aiven console
#    - Format: postgresql+asyncpg://user:pass@host:port/db
#
# 3. Add your OpenAI API key to OPENAI_API_KEY
#    - Get from: https://platform.openai.com/api-keys
#
# 4. Generate a SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 5. Update CORS origins for your frontend domains
#
# 6. Set ENVIRONMENT and DEBUG appropriately:
#    - local/development: DEBUG=true
#    - production: DEBUG=false, ENVIRONMENT=production
#
# 7. Test your configuration:
#    python main.py
#
# =============================================================================
