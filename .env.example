# ============================================================
# PiXerse LP Chatbot - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# For Hugging Face deployment, set these as Space Secrets
# ============================================================

# ==================== DATABASE CONFIGURATION ====================

# PostgreSQL Database (Aiven or any PostgreSQL provider)
# Format: postgresql+asyncpg://username:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname
DB_URL=postgresql+asyncpg://user:password@host:port/dbname

# MongoDB Atlas (for chat history)
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_DB_NAME=PiXerse_ChatBot
MONGODB_COLLECTION_NAME=chat_sessions
MONGODB_TIMEOUT=5000

# ==================== AI SERVICES ====================

# OpenAI API Key (required for chatbot functionality)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key (optional, for Claude models)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ==================== APPLICATION SETTINGS ====================

# Application Environment
APP_ENV=production
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=*

# Server Configuration (Hugging Face uses port 7860)
HOST=0.0.0.0
PORT=7860

# ==================== CORS SETTINGS ====================

# CORS Origins (comma-separated)
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true

# ==================== LOGGING ====================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==================== RATE LIMITING ====================

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# ==================== MONITORING (Optional) ====================

# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn-here

# ==================== MCP CONFIGURATION ====================

# MCP Server Configuration
MCP_SERVER_NAME=mcp-server
MCP_TIMEOUT=30

# ==================== NOTES ====================
# 
# For Hugging Face Spaces:
# 1. Go to your Space Settings > Variables and Secrets
# 2. Add each variable as a Secret (not Variable) for sensitive data
# 3. Port 7860 is required by Hugging Face
# 4. Set APP_ENV=production for production deployment
#
# For Local Development:
# 1. Copy this file to .env
# 2. Fill in your actual credentials
# 3. Never commit .env to git!
#
# ============================================================

